<!DOCTYPE html>
<html>
	<head>
    <%- partial('_partial/head') %>
  </head>
	<body>
    <div class="mobile-header">
      <a class="mobile-men-btn iconfont icon-genduo" onclick="mobileHeaderToggle()"></a>
      <a href="/" class="logo" alt="<%= config.title %>">
        <img src="/images/logo.svg" alt="<%= config.title %>" />
      </a>
    </div>
    <div class="main-left">
      <a href="/" class="logo" alt="<%= config.title %>">
        <img src="/images/logo.svg" alt="<%= config.title %>" />
      </a>
      <form class="search" action="//baidu.com/baidu" method="get" accept-charset="utf-8">
        <div class="search-warp">
          <img src="/images/search.svg" alt="搜索" />
          <input  type="text" type="search" name="word" results="0" placeholder="Search by article" />
          <input type="hidden" name="si" value="<%- config.url.replace(/^https?:\/\//, '') %>">
          <input name=tn type=hidden value="bds">
          <input name=cl type=hidden value="3">
          <input name=ct type=hidden value="2097152">
          <input name=s type=hidden value="on">
        </div>
      </form>
      <nav>
        <% if (theme.menu) { %>
          <% theme.menu.forEach(function(nav) { %>
          <div class="nav-item <%- is_current(nav.link) ? 'active' : '' %>">
            <div class="nav-item-warp">
              <a href="<%= nav.link %>" class="name" alt="<%= nav.name %>"><%= nav.name %></a>
            </div>
          </div>
          <% }); %>
        <% } %>
        <div class="nav-tips">
          目录
        </div>
        <div class="menu-list">
          <% site.categories.each(function(categorie,index) { %>
            <div class="nav-item <%= page.categories && page.categories.data[0].name === categorie.name ? 'active' : '' %>">
              <div class="nav-item-warp" onclick="navToggle(this)">
                <span class="name"><%- categorie.name %></span>
                <span class="icon iconfont icon-right"></span>
              </div>
              <div class="nav-child-warp">
                <% categorie.posts.each(function(post,postIndex) { %>
                <a class="nav-child-item <%- is_current(url_for(post.path)) ? 'active' : '' %>" href="<%= url_for(post.path) %>" alt="<%= post.title %>"><%= post.title %></a>
                <% }) %>
              </div>
            </div>
            <% }) %>
        </div>
      </nav>
      <div class="custom">
        <a href="https://www.aliyun.com/minisite/goods?userCode=1safmcjh" target="_blank"><img src="https://img.alicdn.com/tfs/TB1Xym03UT1gK0jSZFrXXcNCXXa-1500-670.png" /></a>
      </div>
      <div class="website-msg">
        <div class="beian"><a alt="备案" title="备案" target="_blank" href="http://www.miitbeian.gov.cn/"><%= theme.beian %></a></div>
        <div class="beian"><span id="busuanzi_container_site_pv">总访问量<span id="busuanzi_value_site_pv"></span>次</span></div>
        <div class="theme-drsc">Power:<a alt="Hexo" title="Hexo" href="https://hexo.io" target="_blank">Hexo</a> Theme:<a href="" target="_blank">Coder</a></div>
        <div class="copyright">Copyright &#169 <a href="mailto:<%= theme.mail %>" alt="<%= theme.mail %>" title="<%= theme.mail %>"><%= theme.copyright %></a> </div>
      </div>
    </div>
    <div class="main-right">
      <%- body %>
    </div>

    <script>
      function navToggle(e) {
        const navs = [ ...document.getElementsByClassName('nav-item') ]
        console.log(navs)
        const index = navs.findIndex(item => item.childNodes[1].innerText === e.childNodes[1].innerText)
        console.log(index)
        navs.forEach((nav,_index) => {
          if(index !== _index){
            nav.classList.remove('open')
          }
        });
        const classList = [...e.parentNode.classList]
        const active = classList.find(item => item === 'active')
        if (active) {
          return
        }
        const isOpen = classList.find(item => item === 'open')
        if (isOpen) {
          e.parentNode.classList.remove('open')
        } else {
          e.parentNode.classList.add('open')
        }
      }

      function mobileHeaderToggle() {
        const mainLeft = document.getElementsByClassName('main-left')[0]
        const offsetLeft = mainLeft.offsetLeft
        const value = offsetLeft === 0 ? '-250px' : '0'
        mainLeft.style.marginLeft = value
        const btn = document.getElementsByClassName('mobile-men-btn')[0]
        if (offsetLeft === 0) {
          btn.classList.remove('icon-guanbi')
          btn.classList.add('icon-genduo')
        } else {
          btn.classList.remove('icon-genduo')
          btn.classList.add('icon-guanbi')
        }
      }
    </script>
    <script async src="//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
    <!-- 百度统计 -->
    <%- partial('_partial/baidu-statistics') %>
  </body>
</html>
