
<%
var title = page.title;
if (is_archive()){
  title = __('归档');
  if (is_month()){
    title += ': ' + page.year + '/' + page.month;
  } else if (is_year()){
    title += ': ' + page.year;
  }
} else if (is_category()){
  title = __('目录') + ': ' + page.category;
} else if (is_tag()){
  title = __('标签') + ': ' + page.tag;
}
%>
<title><% if (title){ %><%= title %> | <% } %><%= config.title %></title>
<meta charset="UTF-8">
<meta name="robots" content="index,follow"/>
<meta name="keywords" content="<%- config.keywords %>"/>
<meta name="description" content="<%- config.description %>"/>
<meta name="viewport" content="width=device-width,initial-scale=1,minimum-scale=1,maximum-scale=1,user-scalable=no" />
<meta name="renderer" content="webkit" />
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="msapplication-tap-highlight" content="no">
<meta name="apple-mobile-web-app-capable" content="yes"/>
<script>
  (function(doc, win, designSize,htmlFontSize) {
  var docEl = doc.documentElement,
          isIOS = navigator.userAgent.match(/\(i[^;]+;( U;)? CPU.+Mac OS X/),
          dpr = isIOS ? Math.min(win.devicePixelRatio, 3) : 1,
          dpr = window.top === window.self ? dpr : 1, //被iframe引用时，禁止缩放
          resizeEvt = 'orientationchange' in window ? 'orientationchange' : 'resize';
  docEl.dataset.dpr = dpr;
  var recalc = function() {
    var width = docEl.clientWidth;
    if (width / dpr > designSize) {
      width = designSize * dpr;
    }
    docEl.dataset.width = width;
    docEl.dataset.percent = htmlFontSize * (width / designSize);
    docEl.style.fontSize = htmlFontSize * (width / designSize) + 'px';
  };
  recalc();
  if (!doc.addEventListener) return;
  win.addEventListener(resizeEvt, recalc, false);
})(document, window,1920,100)
</script>
<% if (theme.favicon){ %>
  <link rel="icon" href="<%- theme.favicon %>">
<% } %>
<link rel="stylesheet" href="https://unpkg.com/purecss@2.0.5/build/pure-min.css" integrity="sha384-LTIDeidl25h2dPxrB2Ekgc9c7sEC3CWGM6HeFmuDNUjX76Ert4Z4IY714dhZHPLd" crossorigin="anonymous">
<link rel="stylesheet" href="//at.alicdn.com/t/font_1738295_w8ykgw4ovc.css">
<%- css('css/global') %>