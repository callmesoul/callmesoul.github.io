
<%
var title = page.title;
if (is_archive()){
  title = __('归档');
  if (is_month()){
    title += ': ' + page.year + '/' + page.month;
  } else if (is_year()){
    title += ': ' + page.year;
  }
} else if (is_category()){
  title = __('目录') + ': ' + page.category;
} else if (is_tag()){
  title = __('标签') + ': ' + page.tag;
}
%>
<title><% if (title){ %><%= title %> | <% } %><%= config.title %></title>
<meta charset="UTF-8">
<meta name="robots" content="index,follow"/>
<meta name="keywords" content=""/>
<meta name="description" content="不超过150个字符"/>
<meta name="viewport" content="width=device-width,initial-scale=1,minimum-scale=1,maximum-scale=1,user-scalable=no" />
<meta name="renderer" content="webkit" />
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="msapplication-tap-highlight" content="no">
<meta name="apple-mobile-web-app-capable" content="yes"/>
<link href="https://cdn.bootcdn.net/ajax/libs/font-awesome/5.15.1/css/regular.css" rel="stylesheet">
<script src="https://cdn.bootcdn.net/ajax/libs/font-awesome/5.15.1/js/regular.js"></script>
<% if (theme.favicon){ %>
  <link rel="icon" href="<%- theme.favicon %>">
<% } %>
<%- js('js/rem') %>
<%- css('css/index') %>